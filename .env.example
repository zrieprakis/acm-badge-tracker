# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# SQLite database file path (relative to backend working directory, or absolute in Docker).
# Sessions are stored in the same database (see backend/src/auth/libsqlSessionStore.ts).
DB_PATH=./data/acm-tracker.db

# Session cookie signing secret - generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=changeme-generate-a-long-random-string

# ACM integration: "mock" for development/testing without a real ACM server, "live" for production
ACM_CLIENT_MODE=mock

# Required when ACM_CLIENT_MODE=live - an ACM identity with REST API access
# (see support.avigilon.com: "How to Configure REST API User Account in ACM")
ACM_BASE_URL=https://your-acm-server-ip-or-hostname
ACM_API_USERNAME=
ACM_API_PASSWORD=

# Avigilon ACM appliances typically present a self-signed certificate, so
# this defaults to "false" (skip verification), matching Avigilon's own
# sample REST client code. Set to "true" only if a proper internal CA
# certificate has been installed on the appliance.
ACM_TLS_REJECT_UNAUTHORIZED=false

# How often (seconds) the backend polls ACM for new access events
POLL_INTERVAL_SECONDS=30

# How long (days) to keep access_event_history rows before pruning
HISTORY_RETENTION_DAYS=30
